# ── App ─────────────────────────────────────────────
APP_URL=https://daywise.smallsoftware.in
INTERNAL_APP_URL=http://app:3000   # worker → app for PDF rendering (docker compose service name)
NODE_ENV=production
SESSION_SECRET=            # 32+ random chars
SUPERADMIN_EMAIL=ayaz@adfox.media

# ── Database ────────────────────────────────────────
POSTGRES_PASSWORD=password   # used by docker-compose postgres; must match DATABASE_URL
DATABASE_URL=postgres://daywise:password@postgres:5432/daywise

# ── AI ──────────────────────────────────────────────
AI_PROVIDER=groq            # groq | gemini | deepseek | qwen
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GROQ_REASONING_EFFORT=low  # none | low | medium | high (gpt-oss); low keeps drafts fast
GEMINI_MODEL=gemini-3.8-flash   # gemini-2.5-flash is closed to new API users
DEEPSEEK_API_KEY=
QWEN_API_KEY=
AI_TIMEOUT_MS=90000         # per-call timeout before falling back
MOCK_AI=0                   # 1 = fixtures instead of real AI and Places (tests, demos)

# ── Google Places (New) ─────────────────────────────
GOOGLE_PLACES_API_KEY=      # server key, IP-restricted to the KVM
PLACES_MONTHLY_TEXT_SEARCH_CAP=30000
PLACES_MONTHLY_PHOTO_CAP=900

# ── Destination images ─────────────────────────────
PEXELS_API_KEY=

# ── Email (magic links) ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Daywise <login@smallsoftware.in>
SUPPORT_EMAIL=support@smallsoftware.in   # shown on sign-in and disabled-link pages

# ── Cloudflare R2 (logos, cached hero images, backups) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=daywise
R2_PUBLIC_URL=              # optional CDN/public bucket URL

# ── Edge (Caddy) ───────────────────────────────────
ACME_EMAIL=                 # Let's Encrypt account email for on-demand TLS

# ── Observability ──────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Deploy (GitHub Actions secrets, not runtime) ───
# DEPLOY_HOST=            KVM IP
# DEPLOY_USER=            deploy
# DEPLOY_SSH_KEY=         private key
