# ── App ─────────────────────────────────────────────
APP_URL=https://planner.smallsoftware.in
NODE_ENV=production
SESSION_SECRET=            # 32+ random chars
SUPERADMIN_EMAIL=ayaz@adfox.media

# ── Database ────────────────────────────────────────
DATABASE_URL=postgres://daywise:password@postgres:5432/daywise

# ── AI ──────────────────────────────────────────────
AI_PROVIDER=groq            # groq | gemini | deepseek | qwen
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
MOCK_AI=0

# ── Google Places (New) ─────────────────────────────
GOOGLE_PLACES_API_KEY=      # server key, IP-restricted to the KVM
PLACES_MONTHLY_TEXT_SEARCH_CAP=30000
PLACES_MONTHLY_PHOTO_CAP=900

# ── Destination images ─────────────────────────────
PEXELS_API_KEY=

# ── Email (magic links) ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Daywise <login@smallsoftware.in>

# ── Cloudflare R2 (logos, cached hero images, backups) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=daywise
R2_PUBLIC_URL=              # optional CDN/public bucket URL

# ── Observability ──────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Deploy (GitHub Actions secrets, not runtime) ───
# DEPLOY_HOST=            KVM IP
# DEPLOY_USER=            deploy
# DEPLOY_SSH_KEY=         private key
